{
  "builds": [
    {
      "src": "src/config/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.13" }
    },
    {
      "src": "deploy.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "staticfiles_build" }
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/staticfiles_build/$1" },
    { "src": "/(.*)", "dest": "src/config/wsgi.py" }
  ]
}
