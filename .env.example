# SMTP settings (used when EMAIL_PROVIDER=django_smtp)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Resend API key (used when EMAIL_PROVIDER=resend)
EMAIL_API_KEY=

# reCAPTCHA v3
RECAPTCHA_SITE_KEY=
