SECRET_KEY=your-secret-key-here
SITE_NAME=Real Estate
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=real_estate
DB_USER=postgres
DB_PASSWORD=your-db-password
