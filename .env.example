SECRET_KEY=your-secret-key-here
SITE_NAME=Real Estate
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — if DB_URL is set it takes precedence over the individual DB_* keys
# below. Use a single connection string in production (e.g. on Vercel).
# DB_URL=postgres://user:password@host:5432/dbname?sslmode=require
DB_NAME=real_estate
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Email provider: 'django_smtp' (default) or 'resend'
EMAIL_PROVIDER=django_smtp
DEFAULT_FROM_EMAIL=your-email@example.com

# SMTP settings (used when EMAIL_PROVIDER=django_smtp)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Resend API key (used when EMAIL_PROVIDER=resend)
EMAIL_API_KEY=

# reCAPTCHA v3
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Maps share link — used for "Get Directions" button
MAPS_URL=
# Google Maps embed URL — get from Google Maps → Share → Embed a map → copy the iframe src
MAPS_EMBED_URL=

# Storage backend: 'local' (dev: disk + WhiteNoise) or 's3' (prod: S3 for static + media/video)
STORAGE_BACKEND=local
# --- The settings below are only required when STORAGE_BACKEND=s3 ---
# Leave the keys blank to use the instance IAM role instead of static credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
# Bucket for collected static assets (CSS/JS/fonts) — immutable 1-year cache
AWS_S3_BUCKET_STATIC=
# Bucket for public media: Wagtail images & uploaded videos
AWS_S3_BUCKET_PUBLIC=
# Optional CloudFront / custom domain in front of the buckets (e.g. cdn.example.com)
AWS_S3_CUSTOM_DOMAIN=
